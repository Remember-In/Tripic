{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-checks.sh\"",
            "timeout": 180,
            "statusMessage": "커밋 전 CI 검사 (audit + typecheck)"
          }
        ]
      }
    ]
  }
}
