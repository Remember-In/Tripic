# Tripic 운영 API. 로컬 서버를 쓸 때만 같은 네트워크의 Mac 주소로 바꾼다.
EXPO_PUBLIC_API_BASE_URL=https://tripic.remin.dev

# 공공데이터포털 > 한국관광공사 국문 관광정보 서비스 일반 인증키
# 앱 번들에 포함되는 공개 설정이므로 비밀키처럼 보호할 수 없다.
EXPO_PUBLIC_KTO_SERVICE_KEY=replace-with-data-go-kr-service-key

# Kakao Developers > 앱 > 앱 키 > 네이티브 앱 키 (공개 식별자)
# 이 값이 있어야 Development Build/TestFlight에 Kakao config plugin이 적용된다.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=replace-with-kakao-native-app-key
