{
  "expo": {
    "name": "Tripic",
    "slug": "tripic",
    "scheme": "tripic",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": ["expo-router", "expo-sqlite"],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tripic.app"
    },
    "android": {
      "package": "com.tripic.app"
    }
  }
}
