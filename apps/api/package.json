{
  "name": "@tripic/api",
  "version": "0.0.7",
  "description": "Tripic API (NestJS) — health/app-config/notices/version + auth/users",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.28",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tripic/shared": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.46",
    "@testcontainers/postgresql": "^12.1.0",
    "@tripic/tsconfig": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "pactum": "^3.9.1",
    "prisma": "^7.9.1",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3.2.7"
  }
}
