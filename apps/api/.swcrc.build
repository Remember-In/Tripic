{
  "$schema": "https://swc.rs/schema.json",
  "sourceMaps": true,
  "exclude": [
    ".*\\.spec\\.ts$",
    ".*\\.e2e-spec\\.ts$"
  ],
  "jsc": {
    "target": "es2024",
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "baseUrl": "./",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "minify": false
}
