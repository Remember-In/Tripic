// Tripic 계정/인증 + 여행 기록 스키마 (P1 확장 — docs/10-auth-db-design.md 참고)
// PRD 제약: GPS 좌표·EXIF 원본·KTO 원천 데이터는 어떤 테이블에도 저장하지 않는다.
// 여행 기록은 사용자가 직접 확정한 값(contentId, 방문일, 일기 본문)만 저장한다.
// 단, 계정별 방문 기록의 서버 저장은 위치정보지원센터 사전 검토 후 출시한다.

// datasource url은 prisma.config.ts에서 관리한다 (Prisma 7).
// 생성 클라이언트는 커밋하지 않는다 — 로컬/CI/Docker에서 `pnpm prisma generate`로 생성.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // apps/api는 CJS로 컴파일되므로 (루트 "type": "module"이지만 api엔 type 필드 없음)
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  KAKAO
  APPLE
}

// 전면 hard delete 정책 (docs/10 §3, docs/11 §3): 탈퇴는 users 행 즉시 삭제 →
// FK cascade 로 소셜 계정·토큰·기록·일기까지 일괄 파기된다. soft delete 용
// status/deletedAt 컬럼은 두지 않는다.
model User {
  id        String   @id @default(uuid(7))
  // 가입 직후 null — 온보딩의 닉네임 설정 단계에서 채운다
  nickname  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  socialAccounts SocialAccount[]
  refreshTokens  RefreshToken[]
  records        Record[]

  @@map("users")
}

model SocialAccount {
  id             String       @id @default(uuid(7))
  provider       AuthProvider
  // Kakao user id(숫자) 또는 Apple sub — provider 중립적으로 문자열 저장
  providerUserId String
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  // provider 전용 자격 증명은 공통 테이블에 nullable 컬럼으로 두지 않고 분리한다 (docs/14 §5)
  appleCredential AppleCredential?

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("social_accounts")
}

// Apple 계정에만 존재 — 회원탈퇴 시 Apple 토큰 revoke 에 쓰는 refresh token (docs/14 §5·§6)
model AppleCredential {
  socialAccountId String        @id
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  // AES-256-GCM 암호문 `v1.<iv>.<authTag>.<ciphertext>` — 원문은 저장하지 않는다
  refreshToken    String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("apple_credentials")
}

model RefreshToken {
  id           String    @id @default(uuid(7))
  // sha256(token) hex — 토큰 원문은 저장하지 않는다
  tokenHash    String    @unique
  // rotation family: 재사용(탈취) 감지 시 같은 familyId 전체를 revoke
  familyId     String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  revokedAt    DateTime?
  // rotation 체인 추적 — 이 토큰을 대체한 신규 토큰 id
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ---------- 여행 기록 (Figma: 기록 생성 / AI 기록 생성 설정 / 내 여행 기록) ----------
// ⚠️ 계정별 방문 기록의 서버 저장은 위치정보지원센터 사전 검토 후 출시 (docs/10 §9)

// AI 기록 생성 설정의 "테마" — 자연・풍경 / 역사・문화 / 음식・체험 / 지역 완주
enum RecordTheme {
  NATURE_SCENERY
  HISTORY_CULTURE
  FOOD_EXPERIENCE
  REGION_COMPLETE
}

// AI 기록 생성 설정의 문체 — 다큐 내레이션체 / 감성 에세이체 / 친구 대화체
enum DiaryStyle {
  DOCU_NARRATION
  EMOTIONAL_ESSAY
  FRIEND_CHAT
}

enum EntrySource {
  USER
  AI
}

// 하나의 기록 = 하나의 테마 묶음. 사용자가 제목 지정 (예: "경주 여행")
model Record {
  id        String       @id @default(uuid(7))
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  // 기록 생성 시 선택 — AI 일기 생성에 사용
  theme     RecordTheme?
  style     DiaryStyle?
  // 해시태그 — N:M 테이블 대신 배열로 단순화 (검색 고도화 필요 시 분리)
  hashtags  String[]     @default([])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  entries RecordEntry[]
  photos  RecordPhoto[]
  places  RecordPlace[]

  // "내 여행 기록" 최근순 조회
  @@index([userId, createdAt(sort: Desc)])
  @@map("records")
}

// 날짜별 일기 — AI 생성 또는 사용자 직접 작성
model RecordEntry {
  id        String      @id @default(uuid(7))
  recordId  String
  record    Record      @relation(fields: [recordId], references: [id], onDelete: Cascade)
  // 일기가 속한 날짜 (시간 없이 날짜 단위)
  date      DateTime    @db.Date
  content   String
  source    EntrySource
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([recordId, date])
  @@map("record_entries")
}

// 일차별 사진 — 위치 메타데이터를 제거한 사본만 저장한다 (docs/11 §3.1).
// 일기 없이 사진만 있는 일차가 가능하므로 entry FK 가 아니라 (recordId, date) 를 직접 갖는다.
// PoC 단계라 bytea 로 DB 에 담고, 규모가 커지면 오브젝트 스토리지로 이관한다.
model RecordPhoto {
  id        String   @id @default(uuid(7))
  recordId  String
  record    Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  // 사진이 속한 일차 (시간 없이 날짜 단위)
  date      DateTime @db.Date
  // EXIF·XMP·GPS 가 없는 것으로 검증된 이미지 바이트
  data      Bytes
  mimeType  String
  // 사용자 총 용량 제한 집계용 (data 를 읽지 않고 합산하기 위해 별도 컬럼)
  size      Int
  createdAt DateTime @default(now())

  @@index([recordId, date])
  @@map("record_photos")
}

// 기록한 관광지 — 사용자가 확정한 KTO contentId만 저장.
// 관광지명/주소/이미지 등 KTO 원천 데이터와 GPS 좌표는 저장하지 않는다 (표시 시 OpenAPI 실시간 조회).
model RecordPlace {
  id           String   @id @default(uuid(7))
  recordId     String
  record       Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  // 한국관광공사 contentId
  ktoContentId String
  // 지도 스탬프/지역별 조회용 코드 (KTO 지역코드 체계, 원천 데이터 아님)
  areaCode     String
  sigunguCode  String?
  categoryCode String?
  // 사용자가 확정한 방문일 — 시간 없이 날짜 단위 (docs/16 §2.1).
  // datetime 으로 두면 같은 날 같은 곳이 시각 차이로 다른 행이 되어 아래 unique 가 무력해지고,
  // 타임존 때문에 지도 집계가 하루씩 어긋난다.
  visitedAt    DateTime @db.Date
  createdAt    DateTime @default(now())

  @@index([recordId])
  // 지역별 조회 · 방문 시군구 진행률(distinct sigungu) 집계용
  @@index([areaCode, sigunguCode])
  // 같은 기록에 같은 관광지를 같은 날 두 번 담지 않는다 (docs/16 §3.1)
  @@unique([recordId, ktoContentId, visitedAt])
  @@map("record_places")
}
