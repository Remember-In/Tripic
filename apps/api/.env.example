# 로컬 개발: 루트에서 `docker compose up -d db` 후 사용
DATABASE_URL=postgresql://tripic:tripic@localhost:48291/tripic?schema=public

# JWT 서명 키 — 32자 이상 랜덤 문자열 (openssl rand -hex 32)
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_DAYS=30

# 카카오 앱 app_id — 필수. 타 카카오 앱 토큰 차단용 (미설정 시 부팅 실패)
KAKAO_APP_ID=

# KAKAO_ADMIN_KEY=              # 현재 불필요 — 회원탈퇴 unlink(admin API) 도입 시에만 사용

# 웹 카카오 로그인 (docs/15-web-client-server-design.md §2)
# 웹은 네이티브 SDK 가 없어 access token 을 만들 수 없으므로, 카카오가 redirect 로 준
# authorization code 를 서버가 교환한다. 아래 둘을 전부 넣거나 전부 주석으로 둔다 —
# 전부 비우면 POST /auth/kakao/web 만 503 이고 네이티브 /auth/kakao 는 그대로 동작한다.
# 일부만 넣으면 부팅 실패. 빈 문자열(KAKAO_WEB_REST_API_KEY=)도 '넣은 값'으로 본다.
#
# 주의: REST API 키는 KAKAO_APP_ID 와 **같은 카카오 애플리케이션**의 것이어야 한다.
# 다른 앱의 키를 넣으면 교환한 토큰이 app_id 대조에서 걸려 운영에서만 401 이 난다.
# KAKAO_WEB_REST_API_KEY=       # 카카오 개발자 콘솔 > 앱 키 > REST API 키
# 쉼표로 구분한 redirect uri 허용목록 — 운영 도메인과 로컬 Vite 를 함께 넣는다.
# 카카오 콘솔의 Redirect URI 등록값과 정확히 일치해야 한다 (http·https 만 허용).
# KAKAO_WEB_REDIRECT_URIS=https://웹도메인/auth/kakao/callback,http://localhost:5173/auth/kakao/callback
# KAKAO_WEB_CLIENT_SECRET=      # 카카오 콘솔에서 Client Secret 을 켠 경우에만 — 선택

# Sign in with Apple (docs/14-apple-login-design.md §7·§8)
# 5개를 전부 넣거나 전부 주석으로 둔다 — 전부 비우면 Apple 로그인만 꺼진 채 기동하고(503),
# 일부만 넣으면 부팅 실패. 빈 문자열(APPLE_TEAM_ID=)도 '넣은 값'으로 보고 부팅을 막는다.
# APPLE_CLIENT_ID=com.tripic.app   # bundle id — identity token 의 aud 와 대조
# APPLE_TEAM_ID=                   # Apple Developer Team ID
# APPLE_KEY_ID=                    # Sign in with Apple 키의 Key ID
# APPLE_PRIVATE_KEY=               # .p8 PEM 전문 — 한 줄이면 줄바꿈을 \n 으로 이스케이프
# SOCIAL_TOKEN_ENCRYPTION_KEY=     # Apple refresh token 암호화 키 — openssl rand -base64 32

PORT=3000

# 한국관광공사 TourAPI 서버 프록시 (docs/15-web-client-server-design.md §4)
# 웹은 브라우저 CORS 때문에 TourAPI 를 직접 호출할 수 없어 서버가 중계한다.
# 비워두면 /tourism 만 503 이고 나머지는 정상 기동한다 (네이티브 앱은 직접 호출이라 무관).
#
# 공공데이터포털 > 마이페이지 > 인증키의 **디코딩 값**을 넣는 것을 권장한다.
# 인코딩 값을 넣어도 서버가 한 번 디코딩해 쓰지만, 디코딩 값이 혼동이 없다.
# 주의: 이 키는 서버 전용이다. 웹 번들(VITE_ 등)에 넣으면 네트워크 탭에 그대로 노출되고
# 일일 쿼터를 도용당한다. 모바일의 EXPO_PUBLIC_KTO_SERVICE_KEY 와는 별개 값이어도 된다.
# KTO_SERVICE_KEY=

# GET /app-config 응답값 (docs/13 §2). 전부 선택 — 비워두면 아래 기본값이 쓰인다.
# 값만 바꾸고 재시작하면 재배포 없이 조정된다.
# KTO_DEFAULT_RADIUS_M=300      # 기본 검색 반경 (PRD 6.4)
# KTO_MAX_RADIUS_M=1000         # 확장 반경
# KTO_MAX_CANDIDATES=5          # 후보 최대 노출 수
# 플래그는 true / false 만 받는다 (on·yes·1 등은 부팅 실패 — 표기를 하나로 고정)
# FEATURE_AI_DIARY=false        # AI 일기 생성 — 구현하지 않기로 결정, 상시 false (docs/11 §3.2)
# FEATURE_PHOTO_UPLOAD=true     # 사진 업로드 — API 존재하므로 기본 true
