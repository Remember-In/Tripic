# 로컬 개발: 루트에서 `docker compose up -d db` 후 사용
DATABASE_URL=postgresql://tripic:tripic@localhost:48291/tripic?schema=public

# JWT 서명 키 — 32자 이상 랜덤 문자열 (openssl rand -hex 32)
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_DAYS=30

# 카카오 앱 app_id — 필수. 타 카카오 앱 토큰 차단용 (미설정 시 부팅 실패)
KAKAO_APP_ID=

# KAKAO_ADMIN_KEY=              # 현재 불필요 — 회원탈퇴 unlink(admin API) 도입 시에만 사용
PORT=3000
